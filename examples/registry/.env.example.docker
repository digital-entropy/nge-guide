# Compose
COMPOSE_PROJECT_NAME=application-registry
COMPOSE_PROFILES=postgres
APP_ENV=production
APP_PORT=8080
APP_URL=http://localhost:8080
HEALTHCHECK_URL=http://localhost:8080/healthz
APP_USER=app
APP_UID=1000
APP_GID=1000

# Immutable production coordinates; avoid latest
REGISTRY=registry.example.com
IMAGE_NAME=organization/application
IMAGE_TAG=replace-with-commit-sha
PLATFORM=linux/amd64

# Select exactly one connection/profile: pgsql+postgres or mysql+mysql
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=application
DB_USERNAME=application
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
APP_KEY=
